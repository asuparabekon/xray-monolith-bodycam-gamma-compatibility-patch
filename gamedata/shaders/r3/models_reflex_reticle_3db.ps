#include "common.h"

uniform float4 shader_scope_params;
uniform float4 s3ds_param_3;

uniform float4 markswitch_color;

#include "reticle_mark_switch.h"
#include "mark_adjust.h"

#define OFFSET 0.0039
#define PARALLAX 1000.0
#define SCALE 160.0

#include "reticle_reflex_vertex.h"

// where the bitmap is sampled before the Mark Switch cell is chosen; a 3dss-scaled MSDF reticle follows it
float2 reflex_legacy_tc(vf I)
{
	float3x3 TBN = float3x3(I.T + OFFSET, I.B + OFFSET, I.N);
    float3 V_tangent = normalize(float3(dot(-I.P, TBN[0]), dot(-I.P, TBN[1]), dot(-I.P, TBN[2])));
    // true PiP keeps a reflex in front of a thermal display rigid (no parallax drift)
    float2 parallax_tc = I.tc0 - V_tangent.xy * PARALLAX * (shader_scope_params.w < -1.5 && s3ds_param_3.x >= 1.5 ? 0.0 : 1.0);
	
	parallax_tc = (parallax_tc + (SCALE - 1) / 2) / SCALE;
	return parallax_tc;
}

float4 reflex_bitmap(vf I, float2 dot_offset)
{
	float2 parallax_tc = reflex_legacy_tc(I);
	
	#ifdef MARK_ADJUST
	parallax_tc = mark_adjust(parallax_tc);
	#endif

    return s_base.Sample(smp_rtlinear, parallax_tc + dot_offset);
}

#include "reticle_msdf_reflex.h"

ReflexReticleOut main(vf I)
{
	const float2 dot_offset = reticle_mark_offset(markswitch_color.a);
	// an MSDF atlas describes itself; the bitmap path never sees one
	const ReticleAtlas msdf_atlas = reticle_atlas_open(s_base);
	// the dot offset applies after the Mark Switch cell is chosen: in cell units it is mark_sides() times larger
	const float2 msdf_legacy_tc = reflex_legacy_tc(I) + dot_offset * mark_sides();
	const float3 msdf = reticle_msdf_reflex(s_base, smp_linear, msdf_atlas, I.P, I.T, I.B, I.N, I.tc0,
		dot_offset, msdf_legacy_tc);
	float4 bitmap = 0;
	if (!msdf_atlas.recognised)
		bitmap = reflex_bitmap(I, dot_offset);
	return reticle_msdf_reflex_out(msdf_atlas, bitmap, msdf);
}
