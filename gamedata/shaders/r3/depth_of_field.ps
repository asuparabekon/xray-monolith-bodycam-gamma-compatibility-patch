#include "common.h"
#include "screenspace_common.h"
#include "screenspace_dof.h"

Texture2D scope_glass_motion;

float4 main(p_screen I) : SV_TARGET
{
	float3 P = SSFX_get_position(I.tc0, 0);
    // A transmitted image focuses optically beyond the physical glass. Keep
    // actual Gbuffer/hardware depth for lighting/occlusion; change only DOF's
    // local position, matching native3DSS's100m focus without a depth stamp.
    float tag=scope_glass_motion.Load(int3(int2(I.tc0*screen_res.xy),0)).w;
    if(tag>2.5 && tag<3.5) P*=100.0/max(P.z,0.0001);
	float3 img = s_image.Sample(smp_nofilter, I.tc0).rgb;

	return float4(SSFX_DOF( I.tc0, P, img ), 1.0);
}
