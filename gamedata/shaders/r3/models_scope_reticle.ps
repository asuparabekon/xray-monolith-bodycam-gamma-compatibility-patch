float4 m_hud_params;
float4 m_hud_fov_params;
float4 ogse_c_screen;
uniform float4 s3ds_param_1;
uniform float4 s3ds_param_2;
uniform float4 s3ds_param_3;
uniform float4 s3ds_param_4;
uniform float4 markswitch_color;
uniform float4 shader_param_8;

float thermal_battery_charge()
{
	// Lua preserves the legacy 1.25 lens value and packs -1..1 charge beside it.
	return clamp((s3ds_param_2.y - 1.251) * 1000.0, -1.0, 1.0);
}

float thermal_power_signal(float charge)
{
	if (charge <= THERMAL_CRITICAL_CHARGE)
		return 0.0;
	if (charge >= THERMAL_LOW_POWER_THRESHOLD)
		return 1.0;

	float pulse = floor(timers.x * THERMAL_FLICKER_RATE);
	float noise = frac(sin(pulse * 12.9898 + 4.1414) * 43758.5453);
	return lerp(THERMAL_FLICKER_MIN_BRIGHTNESS, 1.0, noise);
}

struct vf
{
    float4 hpos : SV_Position;
    float2 tc0 : TEXCOORD0;	
	float3 w_P : POSITION0;
	float3 w_T : TANGENT0;
	float3 w_B : BINORMAL0;
	float3 w_N : NORMAL0;
	float3 v_P : POSITION1;
	float3 v_T : TANGENT1;
	float3 v_B : BINORMAL1;
	float3 v_N : NORMAL1;
};

float3x3 cotangent_frame(float3 N, float3 P, float2 uv)
{
    float3 dp1 = ddx(P);
    float3 dp2 = ddy(P);
    float2 duv1 = ddx(uv);
    float2 duv2 = ddy(uv);

    float3 dp2perp = cross(dp2, N);
    float3 dp1perp = cross(N, dp1);
    float3 T = dp2perp * duv1.x + dp1perp * duv2.x;
    float3 B = dp2perp * duv1.y + dp1perp * duv2.y;

    float invmax = rsqrt(max(dot(T, T), dot(B, B)));
    return float3x3(T * invmax, B * invmax, N);
}

float4 sample_shadow(float2 tc, float shadow_width)
{
	float a = smoothstep(0.5 - shadow_width, 0.5, distance(tc, float2(0.5, 0.5))); 
	return float4(0, 0, 0, a);
}

float4 sample_zoom_switch_shadow(float2 tc, float min_zoom, float max_zoom)
{
	float shift = smoothstep(min_zoom, max_zoom, ogse_c_screen.x);
	float a = smoothstep(1 - 0.1, 1, distance(tc, float2(0.5 + shift * 3, 0.5)));
	float b = smoothstep(1 - 0.4, 1, distance(tc, float2(-2.5 + shift * 3, 0.5)));
	return float4(0, 0, 0, a * b);
}

float2 project(float2 tc, float2 tangent, float distance, float size)
{
    float2 parallax_tc = tc - tangent * distance;
	parallax_tc.x = (parallax_tc.x + (size - 1) / 2) / size;
	parallax_tc.y = (parallax_tc.y + (size - 1) / 2) / size;
    return parallax_tc;
}

float4 blur_sample(float2 uv)
{
    float4 color = float4(0, 0, 0, 0);
	float blur_amount = 0.006;
	float dither_amount = 0.006;

	float2 offsets[9] = {
		float2(-1, -1), float2(0, -1), float2(1, -1),
		float2(-1,  0), float2(0,  0), float2(1,  0),
		float2(-1,  1), float2(0,  1), float2(1,  1)
	};
	float weights[9] = {
		1.0 / 16.0, 2.0 / 16.0, 1.0 / 16.0,
		2.0 / 16.0, 4.0 / 16.0, 2.0 / 16.0,
		1.0 / 16.0, 2.0 / 16.0, 1.0 / 16.0
	};

	// Generate a small random offset for dithering
	float2 dither = float2(
		(frac(sin(dot(uv, float2(12.9898, 78.233))) * 43758.5453) - 0.5) * dither_amount,
		(frac(sin(dot(uv, float2(93.9898, 67.345))) * 43758.5453) - 0.5) * dither_amount
	);

	for (int i = 0; i < 9; i++)
	{
		color += s_prev_frame.Sample(smp_base, uv + offsets[i] * blur_amount + dither) * weights[i];
	}

	return color;
}

float3 chroma_sample(float2 lens_tc, float2 back_tc, float current_fov, float power)
{
    float3 color_sum = float3(0, 0, 0);
    float3 weight_sum = float3(0, 0, 0);
    
    for(int i = 0; i <= 16; ++i)
    {
        float step = i / 16.0;

        float2 delta = lens_tc - 0.5;
		float zoom_multiplier = min(1, 0.004 * (180 / current_fov));
        delta = sign(delta) * pow(abs(delta), 3.5) * (2 * power + zoom_multiplier);
        float2 coord = back_tc + (step - 0.5) * delta;
        
        float3 weight = float3(step, 1.0 - abs(step + step - 1.0), 1.0 - step);
        weight = lerp(float3(0.5, 0.5, 0.5), weight, 2.0);
        
        float3 color = s_prev_frame.Sample(smp_base, coord).rgb;
        color_sum += color * color * weight;
        
        weight_sum += weight;
    }

    return max(0.0001, sqrt(color_sum / weight_sum));
}

float3 back_image_sample(float2 lens_tc, float2 back_tc, float current_fov, float power, bool blur, bool chroma)
{
    if (blur) {
		return blur_sample(back_tc);
	}
	
	if (chroma) {
		return chroma_sample(lens_tc, back_tc, current_fov, power);
	}
	
	return s_prev_frame.Sample(smp_base, back_tc).rgb;
}

float scope_nvg_heat(float2 tc)
{
	float2 heat_pos = saturate(tc) * (screen_res.xy - 1.0);
	float3 heat = s_heat.Load(int3(heat_pos, 0), 0).rgb;
	return max(heat.r, max(heat.g, heat.b));
}

float scope_nvg_contour(float2 tc, float radius)
{
	float2 pixel = radius / screen_res.xy;
	float2 tc_left = saturate(tc - float2(pixel.x, 0.0));
	float2 tc_right = saturate(tc + float2(pixel.x, 0.0));
	float2 tc_up = saturate(tc - float2(0.0, pixel.y));
	float2 tc_down = saturate(tc + float2(0.0, pixel.y));

	float heat_center = scope_nvg_heat(tc);
	float heat_left = scope_nvg_heat(tc_left);
	float heat_right = scope_nvg_heat(tc_right);
	float heat_up = scope_nvg_heat(tc_up);
	float heat_down = scope_nvg_heat(tc_down);
	float heat_edge = max(max(abs(heat_center - heat_left), abs(heat_center - heat_right)),
		max(abs(heat_center - heat_up), abs(heat_center - heat_down)));
	float heat_nearby = max(heat_center, max(max(heat_left, heat_right), max(heat_up, heat_down)));

	gbuffer_data gbd_center = gbuffer_load_data(tc, tc * screen_res.xy, 0);
	gbuffer_data gbd_left = gbuffer_load_data(tc_left, tc_left * screen_res.xy, 0);
	gbuffer_data gbd_right = gbuffer_load_data(tc_right, tc_right * screen_res.xy, 0);
	gbuffer_data gbd_up = gbuffer_load_data(tc_up, tc_up * screen_res.xy, 0);
	gbuffer_data gbd_down = gbuffer_load_data(tc_down, tc_down * screen_res.xy, 0);
	float3 center_normal = normalize(gbd_center.N + 0.0001);
	float normal_left = 1.0 - saturate(dot(center_normal, normalize(gbd_left.N + 0.0001)));
	float normal_right = 1.0 - saturate(dot(center_normal, normalize(gbd_right.N + 0.0001)));
	float normal_up = 1.0 - saturate(dot(center_normal, normalize(gbd_up.N + 0.0001)));
	float normal_down = 1.0 - saturate(dot(center_normal, normalize(gbd_down.N + 0.0001)));
	float normal_edge = max(max(normal_left, normal_right), max(normal_up, normal_down));
	float depth_scale = max(abs(gbd_center.P.z), 1.0);
	float depth_left = abs(gbd_center.P.z - gbd_left.P.z);
	float depth_right = abs(gbd_center.P.z - gbd_right.P.z);
	float depth_up = abs(gbd_center.P.z - gbd_up.P.z);
	float depth_down = abs(gbd_center.P.z - gbd_down.P.z);
	float depth_edge = max(max(depth_left, depth_right), max(depth_up, depth_down)) / depth_scale;
	float contour = max(heat_edge * 5.0, normal_edge * 1.35 + saturate(depth_edge * 5.0));
	return saturate(contour) * smoothstep(0.01, 0.10, heat_nearby);
}

int fusion_code_value()
{
	return int(floor(frac(s3ds_param_4.w) * 10000.0 + 0.5)) % 10;
}

int fusion_color_value()
{
	return 1 + (fusion_code_value() % 4);
}

int packed_white_fusion_value()
{
	return int(floor(s3ds_param_3.z * 102.0 + 0.5));
}

float white_fusion_fade()
{
	return float(packed_white_fusion_value() % 101) / 100.0;
}

float decoded_dirt_intensity()
{
	if (fusion_color_value() != 3)
		return s3ds_param_3.z;
	return floor(float(packed_white_fusion_value()) / 101.0) / 100.0;
}

float3 apply_nvg(float2 tc, float3 img)
{
	// Adapted from Beef's Shader Based NVGs. The scope mesh supplies the mask,
	// so only generation, gain and image-tube processing are applied here.
	float packed_nvg = frac(s3ds_param_4.w);
	int generation = clamp(int(floor(packed_nvg * 10.0 + 0.001)), 1, 4);
	float gain = max(floor((packed_nvg - float(generation) * 0.1) * 1000.0 + 0.5) / 10.0, 0.1);
	int fusion_color = fusion_color_value();

	float3 tube_color = generation == 1
		? float3(0.7, 1.0, 0.6)
		: generation == 2
			? float3(0.5, 1.0, 0.4)
			: float3(0.2, 1.0, 0.9);
	float crt_strength = generation == 1 ? 0.05 : generation == 2 ? 0.07 : 0.10;
	float noise_strength = generation == 1 ? 0.15 : generation == 2 ? 0.10 : 0.08;
	float scintillation = generation == 1 ? 0.9990 : generation == 2 ? 0.9991 : 0.9992;
	float sharpen_strength = generation == 1 ? 0.0 : generation == 2 ? 0.25 : 0.50;
	if (generation == 4)
	{
		tube_color = float3(1.0, 0.70, 0.40);
		crt_strength = 0.0;
		noise_strength = 0.0;
		scintillation = 1.0;
		sharpen_strength = 0.50;
	}

	float luma = dot(max(img, 0.0), float3(0.299, 0.587, 0.114));
	float2 pixel = 1.0 / screen_res.xy;
	float neighbor_luma = 0.25 * (
		dot(s_prev_frame.SampleLevel(smp_base, tc + float2(pixel.x, 0), 0).rgb, float3(0.299, 0.587, 0.114))
		+ dot(s_prev_frame.SampleLevel(smp_base, tc - float2(pixel.x, 0), 0).rgb, float3(0.299, 0.587, 0.114))
		+ dot(s_prev_frame.SampleLevel(smp_base, tc + float2(0, pixel.y), 0).rgb, float3(0.299, 0.587, 0.114))
		+ dot(s_prev_frame.SampleLevel(smp_base, tc - float2(0, pixel.y), 0).rgb, float3(0.299, 0.587, 0.114)));
	luma += (luma - neighbor_luma) * sharpen_strength;
	// Beef's combine pass amplifies scene luminance before applying tube gain.
	luma *= 4.0 * gain;

	float2 grain_tc = tc - fmod(tc, float2(3.0, 3.0) / screen_res.xy);
	float grain = frac(sin(dot(grain_tc, float2(12.0, 78.0) + timers.x)) * 22738.0);
	float scintillation_jitter = frac(sin(dot(tc, float2(39.346, 11.135) + timers.x)) * 78372.0);
	luma += (grain - 0.5) * 2.0 * noise_strength * sqrt(gain);
	if (scintillation_jitter > scintillation - ((1.0 - scintillation) * (gain - 1.0)))
	{
		luma = 1.0;
	}

	float3 nvg = saturate(luma) * tube_color;
	float scanline = clamp(0.35 + 0.35 * sin(tc.y * screen_res.y * 2.0), 0.0, 1.0);
	float3 crt = nvg * (0.4 + 0.7 * pow(scanline, 1.7));
	nvg = lerp(nvg, crt, crt_strength);
	if (nvg.g >= 0.95)
	{
		nvg = pow(nvg.ggg, 2.0);
	}

	if ((fusion_color == 1 || fusion_color == 2)
		&& SETTING(int(floor(s3ds_param_4.w)), ST_FUSION_OUTLINE)
		&& (thermal_battery_charge() < -0.5 || thermal_battery_charge() > THERMAL_CRITICAL_CHARGE))
	{
		float core = smoothstep(0.12, 0.42, scope_nvg_contour(tc, 0.70));
		float halo = smoothstep(0.035, 0.24, scope_nvg_contour(tc, 2.25));
		float3 outline_color = fusion_color == 2
			? float3(1.0, 0.16, 0.08)
			: float3(1.0, 0.78, 0.48);
		float outline_alpha = saturate(core * 0.54 + halo * 0.11);
		nvg = lerp(nvg, outline_color, outline_alpha);
		nvg += outline_color * halo * 0.12;
	}

	return saturate(nvg);
}

float3 apply_white_fusion(float2 tc, float3 image)
{
	int fusion_color = fusion_color_value();
	if ((fusion_color != 3 && fusion_color != 4)
		|| !SETTING(int(floor(s3ds_param_4.w)), ST_FUSION_OUTLINE)
		|| (thermal_battery_charge() >= -0.5 && thermal_battery_charge() <= THERMAL_CRITICAL_CHARGE))
		return image;

	float core = smoothstep(0.12, 0.42, scope_nvg_contour(tc, 0.70));
	if (fusion_color == 4)
	{
		float halo = smoothstep(0.035, 0.24, scope_nvg_contour(tc, 2.25));
		float heat_fill = smoothstep(0.05, 0.32, scope_nvg_heat(tc));
		float3 green = float3(0.20, 0.92, 0.30);
		image = lerp(image, green, heat_fill * 0.144);
		image = lerp(image, green, saturate(core * 0.18 + halo * 0.027));
		return saturate(image + green * halo * 0.0135);
	}

	float outline_alpha = saturate(core * white_fusion_fade());
	return lerp(image, float3(1.0, 1.0, 1.0), outline_alpha);
}

float3 lcd_effect(int2 hpos)
{
	float pb = 0.4;
    float3 lcdColor = float3(pb, pb, pb);
	
    int px = int(fmod(hpos.x, 3));
	if (px == 1)
		lcdColor.r = 1;
    else if (px == 2)
		lcdColor.g = 1;
    else
		lcdColor.b = 1;
    
    float sclV = 0.25;
    if (int(fmod(hpos.y, 3)) == 0)
		lcdColor.rgb = float3(sclV, sclV, sclV);
	
	return lcdColor;
}

float2 fisheye_shift(float2 uv, float progress, float2 center)
{
	uv -= center;
    
	float ratio = 1;
	float pUvX = pow(uv.x * ratio, 2);
	float pUvY = pow(uv.y, 2);
	float pSum = pUvX + pUvY;
	float multiplier = 10 * (1 - progress);
	float strength = 1 - multiplier * pSum;
	uv *= strength;
    
	uv += center;
	return uv;
}

float2 fisheye(float2 tc, float2 tangent)
{
	float FISHEYE_STRENGTH = -0.3;
	float FISHEYE_PROJECT = 2;

	float fish_power = 1 + FISHEYE_STRENGTH * length(tangent);
	float2 fished = fisheye_shift(tc, fish_power, project(float2(0.5, 0.5), tangent, FISHEYE_PROJECT, 1.0));
	return fished - tc;
}

// The 1P59 dial's angle (reticle_dial_angle). Non-linear zoom correction: zoom_part should normally range from
// 0.0 (3x) to 1.0 (10x).
float scope_dial_angle(float zoom_part)
{
	return reticle_dial_angle(pow(saturate(zoom_part), 1.069));
}

float current_lum()
{
	float lum_min = 0.85;
	float lum_max = 3;
	float lum = s_tonemap.Load(int3(0, 0, 0)).x;
	return clamp(1 - (lum - lum_min) / (lum_max - lum_min), 0, 1);
}

float current_lum_2(float2 tc)
{
    float3 c = s_blur_2.Sample(smp_base, float2(0.5, 0.5)).rgb;
    return dot(c, float3(0.299, 0.587, 0.114));
}


float4 rgba_blend(float4 b, float4 a)
{
	float na = a.a + b.a * (1 - a.a);
	float3 nc = na > 0 ? (a.rgb * a.a + b.rgb * b.a * (1 - a.a)) / na : float3(0, 0, 0);
	return float4(nc, na);
}

float sample_vignette(float2 tc)
{
    float dist = length(tc - 0.5);
    float vig = 1.0 - dist * 2;
    return pow(vig, dist * 1.0);
}

float4 sample_specular(float3 pnt, float3 normal, float3 light_direction)
{
	float w = pow(abs(dot(normalize(pnt + light_direction), normal)), 3072);
	return float4(L_sun_color.rgb * w, w);
}

float3 sample_lens_normalmap(float2 tc, float radius)
{
	float2 xy = (tc - 0.5) * 2;
	return float3(xy, sign(radius) * sqrt(pow(radius, 2) - dot(xy, xy)));
}

float3 sample_reflections(float2 tc, float parallax_factor, float radius, float dirt_factor, float3x3 TBNw_inv, float3 w_pos, float3 w_nrm, float lum, bool is_flat)
{
	float3 normalmap = sample_lens_normalmap(tc, radius);
	if (is_flat)
		normalmap = float3(0, 0, 1);
    float3 lensnormal = normalize(float3(dot(normalmap, TBNw_inv[0]), dot(normalmap, TBNw_inv[1]), dot(normalmap, TBNw_inv[2])));

	float3 reflections = s_reflection.SampleLevel(smp_base, reflect(normalize(normalize(w_pos - eye_position) - normalize(w_nrm) * parallax_factor), lensnormal), 0).rgb;
	if (!is_flat)
		reflections *= sample_vignette(tc);
	
	return reflections * normalize(0.3 + L_ambient.rgb + L_hemi_color.rgb);
}

float sample_reflections_weight(float dirt_factor, float3 w_pos, float3 w_nrm, float lum, bool see_through)
{
	float angle_factor = smoothstep(0, 0.03, (dot(normalize(w_pos - eye_position), normalize(w_nrm)) + 1) / 2);
	if (!see_through) {
		angle_factor = lerp(1, angle_factor, m_hud_params.x);
	}
	return
		angle_factor
		* smoothstep(0, 1, lum)
		* pow(1 - dirt_factor, 10)
		* REFLECTIONS_FACTOR;
}

float3 sample_specular(float2 tc, float parallax_factor, float radius, float specular_factor, float dirt_factor, float3x3 TBNw_inv, float3 w_pos, float3 w_nrm, bool see_through)
{
	float3 normalmap = sample_lens_normalmap(tc, radius);
	
	float angle_factor = smoothstep(0, 0.03, (dot(normalize(w_pos - eye_position), normalize(w_nrm)) + 1) / 2);
	if (!see_through) {
		angle_factor = lerp(1, angle_factor, m_hud_params.x);
	}

	float4 specular = sample_specular(
		normalize(normalize(w_pos - eye_position) - normalize(w_nrm) * parallax_factor),
		normalize(float3(dot(normalmap, TBNw_inv[0]), dot(normalmap, TBNw_inv[1]), dot(normalmap, TBNw_inv[2]))),
		normalize(L_sun_dir_w)
	) * 4;
	specular.w *= L_material.g * angle_factor;
	specular.w = min(1, specular.w);
	specular.w *= pow(1 - dirt_factor, 10);
	specular.w *= specular_factor;
	
	return specular.rgb * specular.a * normalize(0.3 + L_ambient.rgb + L_hemi_color.rgb);
}

float3 HSVtoRGB(float3 hsv)
{
	if (hsv.y == 0.0)
		return hsv.z;

	float i = floor(hsv.x * 6.0);
	float f = hsv.x * 6.0 - i;
	float p = hsv.z * (1.0 - hsv.y);
	float q = hsv.z * (1.0 - f * hsv.y);
	float t = hsv.z * (1.0 - (1.0 - f) * hsv.y);

	i = fmod(i, 6.0);

	if (i == 0.0)
		return float3(hsv.z, t, p);
	else if (i == 1.0)
		return float3(q, hsv.z, p);
	else if (i == 2.0)
		return float3(p, hsv.z, t);
	else if (i == 3.0)
		return float3(p, q, hsv.z);
	else if (i == 4.0)
		return float3(t, p, hsv.z);
	return float3(hsv.z, p, q);
}

float3 tonemap(float3 color, float3 v_pos)
{
    float fog = saturate(length(v_pos) * fog_params.w + fog_params.x);
    color = lerp(color, fog_color, fog);
	color = lerp(color, fog_color, saturate(fog * fog));

	color *= s_tonemap.Load(int3(0, 0, 0)).x;
	const float fWhiteIntensity = 1.7;
	const float fWhiteIntensitySQR = fWhiteIntensity * fWhiteIntensity;
    return (color * (1 + color / fWhiteIntensitySQR)) / (color + 1);
}

float4 scope_reticle_color(vf I, out float4 emission, out float4 glow)
{
	emission = 0;
	glow = 0;
	float RETICLE_SIZE = s3ds_param_1.x;
	float EYE_RELIEF = s3ds_param_1.y;
	float EXIT_PUPIL = s3ds_param_1.z;
	int FFP = s3ds_param_1.w;
	
	float MIN_ZOOM_FOV = m_hud_fov_params.y * 0.75;
	float MAX_ZOOM_FOV = m_hud_fov_params.x * 0.75;
	float REFLECTION_HUE = s3ds_param_2.x;
	int MIN_ZOOM_1X = s3ds_param_2.z;
	float ZOOM_FACTOR = s3ds_param_2.w - fmod(s3ds_param_2.w, 0.01);
	
	int IMAGE_TYPE = s3ds_param_3.x;
	int RETICLE_TYPE = s3ds_param_3.y;
	// A reticle atlas describes itself: the profile's type still shapes the lens (and the legacy reticle coordinate
	// below), its bitmap decoding never applies (MARK_TYPE)
	const ReticleAtlas atlas = reticle_atlas_open(s_base);
	float DIRT_INTENSITY = decoded_dirt_intensity();
	float CHROMA_POWER = s3ds_param_3.w;
	
	float3 LENS_COLOR = s3ds_param_4.xyz;
	int SETTINGS = s3ds_param_4.w;

	// ZOOM_FACTOR = 1 => (0, 1); ZOOM_FACTOR = 1.5 => (0.4, 1.1)
	float IMAGE_PROJECT = 0.8 * ZOOM_FACTOR - 0.8;
	float IMAGE_SIZE = 0.2 * ZOOM_FACTOR + 0.8;
	
	float RETICLE_PROJECT = 10;
	float SHADOW_WIDTH = 0.15;
	
	if (RETICLE_TYPE == RT_FLAT_SCREEN)
		RETICLE_PROJECT = 0;
	
	float3x3 TBN;
	if (SCOPE_PRECISION_MODE == 1)
		TBN = float3x3(I.v_T + 0.0039, I.v_B + 0.0039, I.v_N);
	else
		TBN = cotangent_frame(I.v_N, I.v_P, I.tc0.xy);
	
    float3 V_tangent = normalize(float3(dot(-I.v_P, TBN[0]), dot(-I.v_P, TBN[1]), dot(-I.v_P, TBN[2])));
	
	float current_zoom = max(MIN_ZOOM_FOV / ogse_c_screen.x, 1);
	float zoom_part = max(0, (ogse_c_screen.x - MIN_ZOOM_FOV) / (MAX_ZOOM_FOV - MIN_ZOOM_FOV));
	if (MAX_ZOOM_FOV == MIN_ZOOM_FOV) {
		zoom_part = 0;
	}
	
	if (MIN_ZOOM_1X) {
		IMAGE_PROJECT *= zoom_part;
		IMAGE_SIZE = 1 + (IMAGE_SIZE - 1) * zoom_part;
	}
	
	if (!SETTING(SETTINGS, ST_CHROMATISM)
		|| (shader_scope_params.w < -1.5 && svp_control.y > 0.5 && IMAGE_TYPE != IT_THERMAL && IMAGE_TYPE != IT_THERMAL_COLOR)) {
		CHROMA_POWER = 0;
	}
	
	float lum = current_lum();
	
	// Sight reticle, true PiP zeroes the view-coupled terms so the reticle sits rigid.
	const bool true_pip = shader_scope_params.w < -1.5;
	float pip_k = true_pip ? 0.0 : 1.0;
	float2 reticle_lens_tc = project(I.tc0, V_tangent.xy * pip_k, RETICLE_PROJECT, RETICLE_SIZE);
float2 reticle_tc = project(I.tc0, V_tangent.xy * pip_k, RETICLE_PROJECT, RETICLE_SIZE * (FFP || RETICLE_TYPE == RT_GIPERON || RETICLE_TYPE == RT_DFP ? current_zoom : 1));

	float lum_2 = current_lum_2(reticle_tc);


	if (RETICLE_TYPE != RT_FLAT_SCREEN)
	{
		float2 fish = fisheye(I.tc0, V_tangent.xy) / current_zoom * pip_k;
		reticle_lens_tc += fish;
		reticle_tc += fish;
	}
	if (svp_physical_optics_active() && svp_barrel_alignment.z > 0.5)
	{
		const float reticle_scale = RETICLE_SIZE
			* (FFP || RETICLE_TYPE == RT_GIPERON || RETICLE_TYPE == RT_DFP ? current_zoom : 1);
		// true PiP zeroes V_tangent above, so this project() path has unit slope.
		const float2 correction = svp_barrel_alignment.xy;
		reticle_lens_tc -= correction / max(RETICLE_SIZE, 0.001);
		reticle_tc -= correction / max(reticle_scale, 0.001);
	}
	// where the bitmap would be sampled: an atlas in 3dss scale mode follows it
	const float2 reticle_legacy_tc = reticle_tc;
	const float2 reticle_legacy_lens_tc = reticle_lens_tc;
	const int MARK_TYPE = atlas.recognised ? RT_NONE : RETICLE_TYPE;
    float4 mark_texture = float4(0, 0, 0, 0);
	if (reticle_tc.x >= 0 && reticle_tc.x <= 1 && reticle_tc.y >= 0 && reticle_tc.y <= 1)
	{
		if (MARK_TYPE == RT_MARK_MAGNIFIER)
			reticle_tc = mark_adjust(reticle_tc);
		mark_texture = s_base.Sample(smp_base, clamp(reticle_tc, 0, 1));
	}
	if (atlas.recognised)
		mark_texture = float4(0, 0, 0, 0);

if (MARK_TYPE == RT_DFP)
{
    float4 tex_ffp = float4(0,0,0,0);
    float4 tex_sfp = float4(0,0,0,0);

    if (reticle_tc.x >= 0 && reticle_tc.x <= 1 && reticle_tc.y >= 0 && reticle_tc.y <= 1)
        tex_ffp = s_base.Sample(smp_base, clamp(reticle_tc, 0, 1));

    if (reticle_lens_tc.x >= 0 && reticle_lens_tc.x <= 1 && reticle_lens_tc.y >= 0 && reticle_lens_tc.y <= 1)
        tex_sfp = s_base.Sample(smp_base, clamp(reticle_lens_tc, 0, 1));

    float vis = max(tex_ffp.r, tex_sfp.g);

    // Blue channel = illumination mask
    float led = tex_sfp.b;

    // When illumination is off (markswitch_color is black), hide the blue channel entirely
    // We can detect that by color intensity or use markswitch_color.a if it toggles LED state
    float illum_enabled = saturate(dot(markswitch_color.rgb, 1.0)); // sums RGB, 0 = off, >0 = on

    // Construct layers
    float4 base_lines = float4(0.0, 0.0, 0.0, vis);
    float4 led_layer  = float4(markswitch_color.rgb, led * illum_enabled);

    mark_texture = rgba_blend(base_lines, led_layer);
}

if (MARK_TYPE == RT_DFP_ALT)
{
    float4 tex_ffp = float4(0,0,0,0);
    float4 tex_sfp = float4(0,0,0,0);

    if (reticle_tc.x >= 0 && reticle_tc.x <= 1 && reticle_tc.y >= 0 && reticle_tc.y <= 1)
        tex_ffp = s_base.Sample(smp_base, clamp(reticle_tc, 0, 1));

    if (reticle_lens_tc.x >= 0 && reticle_lens_tc.x <= 1 && reticle_lens_tc.y >= 0 && reticle_lens_tc.y <= 1)
        tex_sfp = s_base.Sample(smp_base, clamp(reticle_lens_tc, 0, 1));

    float vis = max(tex_ffp.r, tex_sfp.g);

    // Blue channel = illumination mask, works only on the FFP
    float led = tex_ffp.b;

    // When illumination is off (markswitch_color is black), hide the blue channel entirely
    // We can detect that by color intensity or use markswitch_color.a if it toggles LED state
    float illum_enabled = saturate(dot(markswitch_color.rgb, 1.0)); // sums RGB, 0 = off, >0 = on

    // Construct layers
    float4 base_lines = float4(0.0, 0.0, 0.0, vis);
    float4 led_layer  = float4(markswitch_color.rgb, led * illum_enabled);

    mark_texture = rgba_blend(base_lines, led_layer);
}
	
	float4 giperon_sfp = float4(0, 0, 0, 0);
	if (MARK_TYPE == RT_GIPERON)
{
    mark_texture = mark_texture.r;
    float finder = s_base.Sample(smp_base, clamp(reticle_lens_tc, 0, 1)).g;

    float angle = scope_dial_angle(zoom_part);

    float2 tc = reticle_lens_tc - 0.5;
    tc = float2(tc.x * cos(angle) - tc.y * sin(angle),
                tc.x * sin(angle) + tc.y * cos(angle));
    tc += 0.5;

    float numbers = s_base.Sample(smp_base, clamp(tc + fisheye(I.tc0, V_tangent.xy) * pip_k, 0, 1)).b;
    giperon_sfp = float4(0, 0, 0, max(finder, numbers));
}

	if (MARK_TYPE == RT_ACOG)
	{
		float3 black = float3(0, 0, 0);
		float3 text = float3(0.3, 0.3, 0.3);
		float tritium_lum = 0.2;
		mark_texture = rgba_blend(rgba_blend(float4(black, mark_texture.r), float4(markswitch_color.rgb * max(tritium_lum, lum * 2), mark_texture.g)), float4(text, mark_texture.b * lum));
	}
	
	
	if (MARK_TYPE == RT_LED || MARK_TYPE == RT_GIPERON)
	{
		mark_texture = float4(markswitch_color.rgb, mark_texture.a);
		giperon_sfp = float4(markswitch_color.rgb, giperon_sfp.a);
	}
	
	if (MARK_TYPE == RT_SPECTER)
	{
		float3 black = float3(0, 0, 0);
		float4 light = float4(0, 0, 0, 0);
		if (markswitch_current.x == 1)
			light = float4(markswitch_color.rgb, mark_texture.g);
		if (markswitch_current.x == 2)
			light = float4(markswitch_color.rgb, mark_texture.b);
		
		mark_texture = rgba_blend(float4(black, mark_texture.r), light);
	}
	
	if (MARK_TYPE == RT_LED_MASKED)
	{
		float3 black = float3(0, 0, 0);
		mark_texture = rgba_blend(float4(black, mark_texture.r), float4(markswitch_color.rgb, mark_texture.g));
	}
	
	if (!SETTING(SETTINGS, ST_SEE_THROUGH))
	{
		mark_texture.rgb *= m_hud_params.x;
		giperon_sfp.rgb *= m_hud_params.x;
	}

	// Specter switch shadow
	float4 zoom_switch_shadow = float4(0, 0, 0, 0);
	if (RETICLE_TYPE == RT_SPECTER)
	{
		const float2 zoom_shadow_tc = svp_physical_optics_active()
			? svp_scope_lens_tc(I.w_P)
			: reticle_lens_tc;
		zoom_switch_shadow = sample_zoom_switch_shadow(zoom_shadow_tc, MIN_ZOOM_FOV, MAX_ZOOM_FOV);
	}
	
	// Fixed reticle-space masks do not share the physical PiP pupil coordinates.
	// Keep them for stock 3DSS only; the geometric eye box owns the PiP boundary.
	float4 mark_shadow = float4(0, 0, 0, 0);
	float4 mark_shadow_blue = float4(0, 0, 0, 0);
	if (!true_pip)
	{
		mark_shadow = sample_shadow(reticle_lens_tc, 0.05);
		mark_shadow_blue = sample_shadow(reticle_lens_tc, CHROMA_POWER / 2);
		mark_shadow_blue.rgb = float3(0.1, 0.1, 0.65);
		if (RETICLE_TYPE == RT_SCREEN || RETICLE_TYPE == RT_FLAT_SCREEN)
		{
			if (reticle_lens_tc.y < 0 || reticle_lens_tc.y > 1 || reticle_lens_tc.x < 0 || reticle_lens_tc.x > 1)
				mark_shadow = float4(0, 0, 0, 1);
			else
				mark_shadow = float4(0, 0, 0, 0);
		}
	}
	
	const float authored_pupil_size = EXIT_PUPIL * (SETTING(SETTINGS, ST_SEE_THROUGH) ? 1 : m_hud_params.x);
	float eyebox_transmission = 1.0;
	float4 shadow_texture;
	if (svp_physical_optics_active())
	{
		const bool inside_excluded = RETICLE_TYPE == RT_SCREEN
			|| RETICLE_TYPE == RT_FLAT_SCREEN
			|| RETICLE_TYPE == RT_SPECTER
			|| RETICLE_TYPE == RT_ACOG
		|| RETICLE_TYPE == RT_MARK_MAGNIFIER;
		const bool uses_authored_inside = svp_scope_uses_authored_inside(FFP, inside_excluded);
		const float2 tube_pupil_tc = svp_scope_tunneling_tc(I.tc0);
		shadow_texture = svp_profiled_tunneling_shadow(tube_pupil_tc, uses_authored_inside);
	}
	else
	{
		const float2 exit_pupil_tc = project(I.tc0, V_tangent.xy, -EYE_RELIEF, authored_pupil_size);
		shadow_texture = sample_shadow(exit_pupil_tc, SHADOW_WIDTH + 0.02 * (current_zoom - 1));
	}
	if (svp_physical_optics_active())
	{
		eyebox_transmission = svp_exit_pupil_transmission(svp_scope_lens_tc(I.w_P));
		shadow_texture = svp_merge_black_shadow(shadow_texture, zoom_switch_shadow);
		zoom_switch_shadow = float4(0, 0, 0, 0);
	}
	if (!svp_physical_optics_active() && !SETTING(SETTINGS, ST_PARALLAX_SHADOW))
	{
		shadow_texture *= 1 - m_hud_params.x;
	}
	
	// LED-illuminated scope interior
	const bool inside_excluded = RETICLE_TYPE == RT_SCREEN
		|| RETICLE_TYPE == RT_FLAT_SCREEN
		|| RETICLE_TYPE == RT_SPECTER
		|| RETICLE_TYPE == RT_ACOG
		|| RETICLE_TYPE == RT_MARK_MAGNIFIER;
	const bool uses_authored_inside = svp_scope_uses_authored_inside(FFP, inside_excluded);
	const bool renders_authored_inside = uses_authored_inside
		&& (!true_pip || svp_physical_optics_active());
	const float2 inside_tc = clamp((reticle_lens_tc - 0.5) * 0.62 + 0.5, 0, 1);
	float4 inside = 0;
	if (renders_authored_inside) {
		inside = svp_sample_authored_inside(inside_tc);
		inside.rgb = markswitch_color.rgb * inside.r;
	}

	// Dirt texture
	float3x3 TBNw_inv = transpose(float3x3(I.w_T, I.w_B, I.w_N));
	float3 normalmap = sample_lens_normalmap(I.tc0, 3);
	float3 lensnormal = normalize(float3(dot(normalmap, TBNw_inv[0]), dot(normalmap, TBNw_inv[1]), dot(normalmap, TBNw_inv[2])));
	float4 dirt = s_dirt.Sample(smp_base, I.tc0);
	dirt = saturate(float4((1 - dirt.rgb) * 1.5 * calc_model_lq_lighting(lensnormal), dirt.a * DIRT_INTENSITY));

	// Back image
	float2 screen_tc = I.hpos.xy * screen_res.zw;
	float zoom = lerp(1, IMAGE_SIZE, m_hud_params.x);
	float shift = lerp(0, IMAGE_PROJECT, m_hud_params.x);
	float2 scope_tc = (1.0 / zoom) * (screen_tc.xy - 0.5) + 0.5;
	V_tangent.x = V_tangent.x / screen_res.x * screen_res.y;
	scope_tc = scope_tc + V_tangent.xy * shift;

	// Atlas reticle angle from the frame pixel this lens pixel shows, so it stays registered with the world.
	// The bore is the lens centre seen at zero parallax; the main camera maps frame UV to view tangents.
	const float2 reticle_tc_dx = ddx(I.tc0);
	const float2 reticle_tc_dy = ddy(I.tc0);
	const float reticle_det = reticle_tc_dx.x * reticle_tc_dy.y - reticle_tc_dy.x * reticle_tc_dx.y;
	const float2 reticle_to_centre = 0.5 - I.tc0;
	const float2 reticle_centre_px = float2(reticle_tc_dy.y * reticle_to_centre.x - reticle_tc_dy.x * reticle_to_centre.y,
		reticle_tc_dx.x * reticle_to_centre.y - reticle_tc_dx.y * reticle_to_centre.x) / (abs(reticle_det) > 1e-12 ? reticle_det : 1e-12);
	const float2 reticle_bore_tc = (screen_tc + reticle_centre_px * screen_res.zw - 0.5) / zoom + 0.5;
	const float2 reticle_tan_half = float2(ogse_c_screen.z / max(ogse_c_screen.y, 0.01), ogse_c_screen.z);
	const float2 reticle_angle = reticle_atlas_angle(atlas, reticle_atlas_frame_tangent(scope_tc, reticle_tan_half),
		reticle_atlas_frame_tangent(reticle_bore_tc, reticle_tan_half));
	const ReticleView reticle_view = reticle_atlas_view_dial(reticle_atlas_view(atlas, reticle_angle, shader_scope_params.x,
		reticle_legacy_tc, reticle_legacy_lens_tc), scope_dial_angle(zoom_part));
	const float4 reticle_illumination = reticle_atlas_lighting(atlas, markswitch_color, markswitch_current.x);
	ReticleMarks reticle_marks = (ReticleMarks)0;
	if (atlas.valid)
		reticle_marks = reticle_atlas_marks(s_base, atlas, reticle_view, markswitch_current.x);

	if (RETICLE_TYPE == RT_SPECTER) {
		float smooth_zoom_part = smoothstep(0, 1, zoom_part);
		if (distance(I.tc0, float2(0.5 + smooth_zoom_part * 3, 0.5)) <= 1)
			scope_tc.x -= 0.2 * smooth_zoom_part;
		if (distance(I.tc0, float2(-2.5 + smooth_zoom_part * 3, 0.5)) <= 1)
			scope_tc.x += 0.2 * (1 - smooth_zoom_part);
	}

	float3 back;
	if ((IMAGE_TYPE == IT_THERMAL || IMAGE_TYPE == IT_THERMAL_COLOR) && markswitch_current.x < 2) {
		float pixelate = SETTING(SETTINGS, ST_THERMAL_PIXELATION) ? int(current_zoom) : 1;
		if (shader_scope_params.w < -1.5) {
			// true PiP panel fill: the sensor frame fills the display, the vertical crop keeps
			// square pixels (panel aspect from screen derivatives)
			float du = length(float2(ddx(I.tc0.x), ddy(I.tc0.x)));
			float dv = length(float2(ddx(I.tc0.y), ddy(I.tc0.y)));
			float hw = (dv > 0.0001) ? saturate(du / dv) : 1.0;
			scope_tc = float2(I.tc0.x, 0.5 + (I.tc0.y - 0.5) * hw);
			// authored pixelation at the optical mag (engine curMag is ratio*optical), the
			// fixed sensor grid is the fallback when the MCM toggle is off
			if (SETTING(SETTINGS, ST_THERMAL_PIXELATION)) {
				float pz = max(floor((shader_scope_params.x / max(svp_optics.w, 1.0)) * 0.4 + 1.0), 1.0);
				scope_tc = (floor(scope_tc * 640.0 / pz) * pz + 0.5) / 640.0;
			}
			else if (svp_control.w > 0.5)
				scope_tc = (floor(scope_tc * 640.0) + 0.5) / 640.0;
		}
		else
			scope_tc = (floor(scope_tc * screen_res.xy / pixelate) * pixelate + 0.5) / screen_res.xy;
		gbuffer_data gbd = gbuffer_load_data(scope_tc, scope_tc * screen_res.xy, 0);
		back = infrared(gbd, scope_tc * screen_res.xy, scope_tc);
		// per-cell sensor noise, reseeded ~12Hz
		if (shader_scope_params.w < -1.5 && svp_control.w > 0.5)
		{
			float2 cell = floor(scope_tc * 640.0);
			float n = frac(sin(dot(cell, float2(12.9898, 78.233)) + floor(timers.x * 12.0) * 3.7) * 43758.5453);
			back *= 0.92 + 0.16 * n;
		}
		if (markswitch_current.x == 1) {
			back = 1 - back;
		}
		if (IMAGE_TYPE == IT_THERMAL_COLOR) {
		    back = s_heat_map.Sample(smp_base, float2(back.x, 0.5));
		}
		// true PiP: content behind the front lens blocks the optic, veil it dark (no geometry clip)
		if (shader_scope_params.w < -1.5 && svp_optics.z > 0 && gbd.P.z > 0.01)
			back *= 0.45 + 0.55 * smoothstep(svp_optics.z - 0.2, svp_optics.z, gbd.P.z);
		// LCD subpixel mask, the stock lcd_effect look re-enabled deliberately for the panel
		if (shader_scope_params.w < -1.5 && svp_control.w > 0.5)
		{
			int2 px = int2(I.hpos.xy);
			float3 m = float3(0.4, 0.4, 0.4);
			int c = px.x % 3;
			if (c == 1) m.r = 1; else if (c == 2) m.g = 1; else m.b = 1;
			if (px.y % 3 == 0) m = float3(0.25, 0.25, 0.25);
			back *= lerp(float3(1, 1, 1), m * 2.0, 0.6);
		}
	} else {
		// true PiP clean optics strip blur/chroma on glass and NV, thermal displays keep theirs
		bool pip_glass_strip = shader_scope_params.w < -1.5 && IMAGE_TYPE != IT_THERMAL && IMAGE_TYPE != IT_THERMAL_COLOR;
		bool blur = SETTING(SETTINGS, ST_NVG_BLUR) && !(pip_glass_strip && svp_control.z > 0.5) && floor(shader_param_8.x) != 0 || m_hud_params.x == 0;
		back = back_image_sample(I.tc0, scope_tc, ogse_c_screen.x, CHROMA_POWER, blur, SETTING(SETTINGS, ST_CHROMATISM) && !(pip_glass_strip && svp_control.y > 0.5));
		back *= LENS_COLOR;
	}

	if (IMAGE_TYPE == IT_THERMAL || IMAGE_TYPE == IT_THERMAL_COLOR) {
		back *= lcd_effect(I.hpos);
	}

	if (IMAGE_TYPE == IT_NV && markswitch_current.x == 0) {
		back = apply_nvg(scope_tc, back);
	}
	back = apply_white_fusion(scope_tc, back);

	// Reflections
	float3 layer1_color = HSVtoRGB(float3(REFLECTION_HUE, 0.16, 1));
	float3 layer2_color = HSVtoRGB(float3(REFLECTION_HUE - 0.1, 0.7, 1));
	float3 layer3_color = HSVtoRGB(float3(REFLECTION_HUE + 0.1, 0.4, 1));
	
	float4 reflections;
	reflections.a = sample_reflections_weight(dirt.a, I.w_P, I.w_N, lum, SETTING(SETTINGS, ST_SEE_THROUGH));
	bool is_flat = RETICLE_TYPE == RT_FLAT_SCREEN;
	reflections.rgb = sample_reflections(I.tc0.xy, 0, 3, dirt.a, TBNw_inv, I.w_P, I.w_N, lum, is_flat) * layer1_color;
	reflections.rgb += sample_reflections(I.tc0.xy, 100, 2, dirt.a, TBNw_inv, I.w_P, I.w_N, lum, is_flat) * layer2_color;
	reflections.rgb += sample_reflections(I.tc0.xy, 40, -1, dirt.a, TBNw_inv, I.w_P, I.w_N, lum, is_flat) * layer3_color;
	// Specular
	float3 specular = sample_specular(I.tc0.xy, 0, 3, SPECULAR_FACTOR, dirt.a, TBNw_inv, I.w_P, I.w_N, SETTING(SETTINGS, ST_SEE_THROUGH)) * layer1_color;
	specular += sample_specular(I.tc0.xy, 100, 2, SPECULAR_FACTOR * 0.1, dirt.a, TBNw_inv, I.w_P, I.w_N, SETTING(SETTINGS, ST_SEE_THROUGH)) * layer2_color;
	specular += sample_specular(I.tc0.xy, 40, -1, SPECULAR_FACTOR * 0.1, dirt.a, TBNw_inv, I.w_P, I.w_N, SETTING(SETTINGS, ST_SEE_THROUGH)) * layer3_color;
	if (is_flat)
		specular = float3(0, 0, 0);

	// Vignette
	float4 vignette = true_pip
		? float4(0, 0, 0, 0)
		: float4(0, 0, 0, smoothstep(0.4, 2, 2 * length(I.tc0.xy - float2(0.5, 0.5))));
	
	// Split result to apply additive layers later
	if (true_pip)
	{
		back *= eyebox_transmission;
		mark_texture.a *= eyebox_transmission;
		if (MARK_TYPE == RT_GIPERON)
			giperon_sfp.a *= eyebox_transmission;
	}

	float4 final_scope_1 = float4(0, 0, 0, 0);
	if (RETICLE_TYPE != RT_SCREEN && RETICLE_TYPE != RT_FLAT_SCREEN)
	{
		mark_shadow_blue.w *= BlackandWhite(back);
		final_scope_1 = rgba_blend(final_scope_1, mark_shadow_blue);
	}
	final_scope_1 = rgba_blend(final_scope_1, vignette);
	
	float4 final_scope_2 = float4(0, 0, 0, 0);
	if (MARK_TYPE != RT_ADDITIVE && MARK_TYPE != RT_MARK_MAGNIFIER && (MARK_TYPE == RT_GIPERON || FFP))
	{
		final_scope_2 = rgba_blend(final_scope_2, mark_texture);
	}
	final_scope_2 = rgba_blend(final_scope_2, mark_shadow);
	final_scope_2 = rgba_blend(final_scope_2, inside);
	if (RETICLE_TYPE != RT_SCREEN && RETICLE_TYPE != RT_FLAT_SCREEN)
	{
		final_scope_2 = rgba_blend(final_scope_2, shadow_texture);
	}
	if (!(MARK_TYPE == RT_ADDITIVE || MARK_TYPE == RT_MARK_MAGNIFIER || MARK_TYPE == RT_GIPERON || FFP))
	{
		final_scope_2 = rgba_blend(final_scope_2, mark_texture);
	}
	if (MARK_TYPE == RT_GIPERON)
	{
		final_scope_2 = rgba_blend(final_scope_2, giperon_sfp);
	}
	final_scope_2 = rgba_blend(final_scope_2, zoom_switch_shadow);
	final_scope_2 = rgba_blend(final_scope_2, reflections);
	
	float4 final_scope_3 = float4(0, 0, 0, 0);
	final_scope_3 = rgba_blend(final_scope_3, dirt);

	// Tonemapping
	
	if (IMAGE_TYPE == IT_THERMAL || IMAGE_TYPE == IT_THERMAL_COLOR)
	{
		back = tonemap(back, I.v_P);
	}
	final_scope_1.rgb = tonemap(final_scope_1.rgb, I.v_P);
	final_scope_2.rgb = tonemap(final_scope_2.rgb, I.v_P);
	final_scope_3.rgb = tonemap(final_scope_3.rgb, I.v_P);
	
	// Result
	
	float3 final_scope = lerp(back, final_scope_1.rgb, final_scope_1.a);
	if (atlas.recognised)
	{
		// one fixed slot under the tube shadow for either focal plane; paint reflects the scene
		const float reticle_reach = true_pip ? eyebox_transmission : 1.0;
		const float3 reticle_paint = reticle_atlas_paint(reticle_marks, dot(back, float3(0.299, 0.587, 0.114)));
		final_scope = lerp(final_scope, reticle_paint, reticle_marks.paint * reticle_reach);
		if (!atlas.valid && reticle_atlas_control.y > 0.5)
			final_scope = lerp(final_scope, float3(1, 0, 1), 0.25);
	}
	if (MARK_TYPE == RT_ADDITIVE || MARK_TYPE == RT_MARK_MAGNIFIER)
	{
		final_scope = saturate(final_scope + mark_texture.rgb * mark_texture.a);
	}
	final_scope = lerp(final_scope, final_scope_2.rgb, final_scope_2.a);
	float3 reticle_emission = 0;
	if (atlas.valid)
	{
		reticle_emission = reticle_atlas_emission(atlas, reticle_marks, reticle_illumination)
			* (1.0 - max(shadow_texture.a, mark_shadow.a))
			* (true_pip ? eyebox_transmission : 1.0)
			* (SETTING(SETTINGS, ST_SEE_THROUGH) ? 1.0 : m_hud_params.x);
		// a thermal display's reticle dims with its battery and goes out when it is flat, like the display
		const float reticle_battery = thermal_battery_charge();
		if ((IMAGE_TYPE == IT_THERMAL || IMAGE_TYPE == IT_THERMAL_COLOR) && markswitch_current.x < 2 && reticle_battery > -0.5)
			reticle_emission *= reticle_battery <= THERMAL_CRITICAL_CHARGE ? 0.0 : thermal_power_signal(reticle_battery);
	}
	if (reticle_atlas_emission_external())
	{
		// the lens covers the glow behind it with its own: its reticle, and the reflex reticles its image shows
		// (a magnifier over a red dot), taken from the copies the engine made with the frame
		float3 reticle_image = 0, reticle_image_glow = 0;
		const bool glass_image = !((IMAGE_TYPE == IT_THERMAL || IMAGE_TYPE == IT_THERMAL_COLOR) && markswitch_current.x < 2)
			&& !(IMAGE_TYPE == IT_NV && markswitch_current.x == 0);
		if (glass_image && reticle_atlas_reflex_glow.y > 0.5)
		{
			const float reach = true_pip ? eyebox_transmission : 1.0;
			float cover = (1.0 - final_scope_1.a) * (1.0 - final_scope_2.a) * (1.0 - final_scope_3.a) * reach;
			if (atlas.recognised)
				cover *= 1.0 - reticle_marks.paint * reach;
			reticle_image = s_reticle_image_emission.SampleLevel(smp_linear, scope_tc, 0).rgb * LENS_COLOR * cover;
			reticle_image_glow = s_reticle_image_glow.SampleLevel(smp_linear, scope_tc, 0).rgb * LENS_COLOR * cover;
		}
		// the lens dirt over the reticle dims its light and scatters part of it into the glow
		emission = float4(reticle_emission * (1.0 - final_scope_3.a) + reticle_image, 1.0);
		glow = float4(reticle_atlas_glow_out(atlas, reticle_emission * (1.0 - 0.5 * final_scope_3.a)).rgb
			+ reticle_image_glow, 1.0);
	}
	else
		final_scope += reticle_atlas_inline(reticle_emission);
	final_scope += specular;
	final_scope = lerp(final_scope, final_scope_3.rgb, final_scope_3.a);


	float battery_charge = thermal_battery_charge();
	if ((IMAGE_TYPE == IT_THERMAL || IMAGE_TYPE == IT_THERMAL_COLOR)
		&& markswitch_current.x < 2
		&& battery_charge > -0.5)
	{
		if (battery_charge <= THERMAL_CRITICAL_CHARGE)
		{
			int battery_texture_code = int(floor(frac(s3ds_param_4.w) * 10000.0 + 0.5)) % 10;
			if (battery_texture_code >= 4)
				final_scope = s_base.Sample(smp_base, clamp(reticle_tc, 0, 1)).rgb;
			else
				final_scope = s_powered_off.Sample(smp_base, clamp(reticle_tc, 0, 1)).rgb;
		}
		else
			final_scope = lerp(THERMAL_POWERED_OFF_COLOR, final_scope, thermal_power_signal(battery_charge));
	}

	return float4(final_scope, 1);
}

// SV_Target2 and 3 take the atlas reticle glow core and glow source when the engine binds its glow targets there
// (reticle_atlas.h); without them both stay 0, which leaves whatever is bound there untouched under the lens blend
struct ScopeReticleOut
{
	float4 color : SV_Target0;
	float4 emission : SV_Target2;
	float4 glow : SV_Target3;
};

ScopeReticleOut main(vf I)
{
	ScopeReticleOut O;
	O.color = scope_reticle_color(I, O.emission, O.glow);
	return O;
}
