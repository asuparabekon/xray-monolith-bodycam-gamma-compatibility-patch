#include "scope_common.h"
#include "svp_hooks_common.h"

// Forward declare functions for better error messages
float3 scope_custom_image(Scope s);
#include "scope_custom_image.h"

float4 scope_custom_reticle(Scope s);
#include "scope_custom_reticle.h"

float scope_custom_shadow(v_out I, Scope s);
#include "scope_custom_shadow.h"

float4 scope_custom_lens(Scope s);
#include "scope_custom_lens.h"

// Which phase bodies this shader object compiles. A wrapper that the engine only ever draws with some
// phases defines the subset, so the compiler never sees the other phases' code.
#ifndef SCOPE_COLOR_WRITE_PHASES
#define SCOPE_COLOR_WRITE_PHASES (SCOPE_PHASE_IMAGE | SCOPE_PHASE_RETICLE | SCOPE_PHASE_SHADOW | SCOPE_PHASE_LENS)
#endif

float4 main(v_out I) : SV_Target
{
    scope = new_Scope(I);


    float4 o;
    if (scope_phase == 0) {
        discard;
    }

    if (scope_phase & SCOPE_PHASE_JITTERFIX) {
        return float4(0,0,0,1);
    }

#if SCOPE_COLOR_WRITE_PHASES & SCOPE_PHASE_IMAGE
    if (scope_phase & SCOPE_PHASE_IMAGE) {
        o = float4(scope_custom_image(scope), 1);
    }
#endif
#if SCOPE_COLOR_WRITE_PHASES & SCOPE_PHASE_RETICLE
    if (scope_phase & SCOPE_PHASE_RETICLE) {
        o = scope_custom_reticle(scope);
        if (scope_debug >= 3 && scope.dbg.a > 0.5)
            o = scope.dbg;
    }
#endif

#if SCOPE_COLOR_WRITE_PHASES & SCOPE_PHASE_SHADOW
    if (scope_phase & SCOPE_PHASE_SHADOW) {
        float c = scope_custom_shadow(I, scope);
        o = float4(0,0,0,c);
    }
#endif

#if SCOPE_COLOR_WRITE_PHASES & SCOPE_PHASE_LENS
    if (scope_phase & SCOPE_PHASE_LENS) {
        o = scope_custom_lens(I, scope);
    }
#endif

    return o;
}
